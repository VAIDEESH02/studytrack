# SQLite is the default. Set an absolute path only if you want another database file.
DATABASE_URL=sqlite:///./backend/studytrack.db
# Keep localhost for local development; append your exact Netlify site origin when deployed.
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.netlify.app
# AI_MODE defaults to mock. Set it to real only when GOOGLE_API_KEY is configured
# as a private environment variable in your shell or hosting provider.
AI_MODE=mock
GEMINI_MODEL=gemini-3.6-flash
