# Local development settings. Copy to .env, then start the API with:
#   uvicorn backend.main:app --reload --port 8000 --env-file .env
# Never commit .env. In production these are set in the Render dashboard (see render.yaml).

# development | production. Production requires a strong SECRET_KEY and secure cookies, and hides /docs.
ENVIRONMENT=development

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty locally to use a temporary key (everyone is signed out whenever the server restarts).
SECRET_KEY=

# How long a sign-in lasts, in hours.
SESSION_HOURS=8

# Must be true in production (HTTPS). Local development runs over http, so keep it false here.
COOKIE_SECURE=false

# Empty means the default SQLite file, backend/studytrack.db.
# Production uses Neon's direct connection string, for example:
#   postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Production only: the shared secret Netlify uses to sign proxied requests (set the same value in
# Netlify's environment variables). When set, the API refuses any request without a valid
# x-nf-sign signature, except GET /health. Leave empty for local development.
PROXY_SIGNING_SECRET=

# Browser origins allowed to call the API directly (comma-separated, never *).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# First administrator. Created at startup only while no users exist; remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Seed the eight-trainee demo roster into an empty database.
SEED_DEMO_DATA=true

# Show the interactive API docs (/docs) even in production.
ENABLE_DOCS=false

# AI Helper: mock (default, offline) or real (Google Gemini, needs GOOGLE_API_KEY).
AI_MODE=mock
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=
